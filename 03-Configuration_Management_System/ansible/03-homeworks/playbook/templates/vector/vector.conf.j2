sources:
  log_file:
    type: file
    read_from: beginning
    ignore_older_secs: 600
    include:
      - {{ log_path }}

sinks:
  clickhouse:
    type: clickhouse
    inputs:
      - log_file
    compression: gzip
    database: {{ db_name }}
    endpoint: http://{{ hostvars[groups['clickhouse'][0]].ansible_host }}:{{ db_port }}
    table: {{ db_table }}
    auth:
      strategy: basic
      password: {{ db_user_password }}
      user: {{ db_user }}
    skip_unknown_fields: true
