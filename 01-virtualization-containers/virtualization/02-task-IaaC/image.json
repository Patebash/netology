{
  "builders": [
    {
      "type":      "yandex",
      "token":     "xxxxxx",
      "folder_id": "xxxxxx",
      "zone":      "ru-central1-b",

      "image_name":        "ubuntu-2204-nginx-{{isotime | clean_resource_name}}",
      "image_family":      "ubuntu-web-server",
      "image_description": "my custom debian with nginx",

      "source_image_family": "ubuntu-2204-lts",
      "subnet_id":           "xxxxx",
      "use_ipv4_nat":        true,
      "disk_type":           "network-ssd",
      "ssh_username":        "ubuntu"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "echo 'updating APT'",
        "sudo apt-get update -y",
        "sudo apt-get install -y nginx",
        "sudo su -",
        "sudo systemctl enable nginx.service",
        "curl localhost"
      ]
    }
  ]
}
